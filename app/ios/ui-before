#!/bin/bash
# LeanMail's UI_BEFORE for framework/native/ci/ui-tests: a bare leanmail-server on a free localhost port
# (DEV_AUTH_BYPASS=1, an in-memory raw store, a throwaway DATA_DIR) with lean/test/fixtures/eml imported.
# The tests read LEANMAIL_TEST_ORIGIN (and LEANMAIL_SCREENSHOTS) from <UI_OUT>/test-env; ui-after stops it.
#
#   UI_BEFORE="$PWD/app/ios/ui-before" UI_AFTER="$PWD/app/ios/ui-after" \
#     APP_DIR=app APP_ROOT=LeanMailApp SCHEME=LeanMailApp app/.lake/packages/elmlean/framework/native/ci/ui-tests
set -euo pipefail
OUT="${1:?the ui-tests evidence directory}"
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
BIN="$ROOT/lean/.lake/build/bin"
# lean/lakefile.lean links Homebrew's curl and openssl@3 on macOS
for f in curl openssl@3; do [ -d "/opt/homebrew/opt/$f" ] || brew install "$f"; done
(cd "$ROOT/lean" && lake build leanmail-server leanmail)
port="$(/usr/bin/python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')"
origin="http://127.0.0.1:$port"
fixture="$OUT/fixture"
mkdir -p "$fixture/data"
PORT="$port" DEV_AUTH_BYPASS=1 PUBLIC_ORIGIN="$origin" DATA_DIR="$fixture/data" ACCOUNT_ID=dev LOG_LEVEL=warn \
  nohup "$BIN/leanmail-server" >"$fixture/server.log" 2>&1 &
echo $! > "$fixture/server.pid"
for _ in $(seq 1 100); do curl -sf "$origin/health" >/dev/null && break; sleep 0.1; done
curl -sf "$origin/health" >/dev/null || { echo "leanmail-server did not start" >&2; tail -20 "$fixture/server.log" >&2; exit 1; }
export LEANMAIL_CONFIG="$fixture/cli.json"
"$BIN/leanmail" login "$origin" --account dev
"$BIN/leanmail" import "$ROOT/lean/test/fixtures/eml"
echo "LEANMAIL_TEST_ORIGIN=$origin" >> "$OUT/test-env"
# under Mac Catalyst the sandboxed test runner cannot write there; the result bundle keeps the screenshots
if [ "${UI_PLATFORM:-iossim}" != maccatalyst ]; then
  mkdir -p "$OUT/screenshots"
  echo "LEANMAIL_SCREENSHOTS=$OUT/screenshots" >> "$OUT/test-env"
fi
